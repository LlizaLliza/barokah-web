---
import { site, nav } from '../site';
---
<footer class="mt-16 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-3">
    <div>
      <p class="font-bold text-brand-dark">{site.name}</p>
      <p class="mt-2 text-sm text-slate-600">{site.tagline}</p>
      
      <p class="mt-3 text-xs font-semibold tracking-wider text-brand">
        RESPONSIF &middot; TERKOORDINASI &middot; TERPERCAYA
      </p>
    </div>

    <nav aria-label="Navigasi footer">
      <p class="text-sm font-semibold text-slate-900">Halaman</p>
      <ul class="mt-2 space-y-1 text-sm">
        {nav.map((item) => (
          <li><a href={item.href} class="text-slate-600 hover:text-brand">{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <address class="text-sm not-italic text-slate-600">
      <p class="font-semibold text-slate-900">Kontak</p>
      <p class="mt-2">{site.address}</p>
      <p class="mt-1"><a href={`tel:${site.phoneHref}`} class="hover:text-brand">{site.phone}</a></p>
      <p class="mt-1"><a href={`mailto:${site.email}`} class="hover:text-brand">{site.email}</a></p>
    </address>
  </div>

  <div class="border-t border-slate-200 py-4 text-center text-xs text-slate-500">
    &copy; {new Date().getFullYear()} {site.name}. All rights reserved.
  </div>
</footer>