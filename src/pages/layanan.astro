---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import truckingFoto from '../assets/armada-cddl.jpg';
import kontainer from '../assets/armada-kontainer-20.jpg';
import cddl from '../assets/armada-cddl.jpg';
import tronton from '../assets/armada-tronton-wb.jpg';
import sdmFoto from '../assets/sdm.jpg';

const anchors = [
  { href: '#trucking', label: 'Trucking & Logistics' },
  { href: '#armada', label: 'Armada' },
  { href: '#sdm', label: 'Human Capital' },
  { href: '#sektor', label: 'Sektor' },
];

const trucking = [
  { judul: 'Transportasi barang', isi: 'Koordinasi pengiriman untuk kebutuhan antarkota maupun antarlokasi.' },
  { judul: 'Penjadwalan pengiriman', isi: 'Perencanaan jadwal dan kebutuhan armada bersama mitra.' },
  { judul: 'Dukungan logistik', isi: 'Koordinasi proses pengangkutan dan distribusi barang.' },
  { judul: 'Layanan sesuai kebutuhan', isi: 'Rute, jenis kendaraan, dan lingkup layanan dikonfirmasi sebelum pelaksanaan.' },
];

const armada = [
  { nama: 'Truk Kontainer 20"', foto: kontainer, alt: 'Truk kontainer 20" milik PT. Barokah Satria Expresindo' },
  { nama: 'CDDL', foto: cddl, alt: 'Armada CDDL PT. Barokah Satria Expresindo' },
  { nama: 'Tronton WB', foto: tronton, alt: 'Armada tronton WB PT. Barokah Satria Expresindo' },
];

const armadaPrinsip = [
  { judul: 'Perencanaan', isi: 'Kebutuhan armada dibahas sebelum pengiriman.' },
  { judul: 'Koordinasi', isi: 'Komunikasi jadwal dan proses operasional.' },
  { judul: 'Kelayakan', isi: 'Pemeriksaan kesiapan unit menjadi perhatian.' },
];

const sdm = [
  'Loading / unloading',
  'Driver & helper',
  'Security / satpam',
  'Operator operasional',
  'Outsourcing / penempatan',
  'Pelatihan & orientasi',
];

const sektor = [
  { judul: 'Distribusi & Pergudangan', isi: 'Dukungan aliran barang dan aktivitas gudang.' },
  { judul: 'Manufaktur', isi: 'Dukungan kebutuhan operasional yang disepakati.' },
  { judul: 'Perdagangan & Ritel', isi: 'Koordinasi untuk kebutuhan distribusi barang.' },
  { judul: 'Konstruksi & Proyek', isi: 'Dukungan pengiriman atau tenaga kerja sesuai lingkup proyek.' },
  { judul: 'Industri Lainnya', isi: 'Kebutuhan khusus dibahas melalui konsultasi awal.' },
];
---
<Layout
  title="Layanan Trucking, Logistik & Human Capital | PT. Barokah Satria Expresindo"
  description="Layanan transportasi barang, penjadwalan pengiriman, armada truk kontainer, CDDL, dan tronton, serta dukungan SDM: loading/unloading, driver, security, dan operator."
>
  <!-- 1. HEADER + NAVIGASI ANCHOR -->
  <section class="mx-auto max-w-6xl px-4 pt-12 md:pt-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand">Layanan Utama</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-900 md:text-4xl">Transportasi, Logistik, dan Dukungan SDM</h1>
    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Bagian halaman">
      {anchors.map((a) => (
        <a href={a.href} class="rounded-full border border-slate-300 px-4 py-1.5 text-sm font-medium text-slate-700 hover:border-brand hover:text-brand">
          {a.label}
        </a>
      ))}
    </nav>
  </section>

  <!-- 2. TRUCKING & LOGISTICS -->
  <section id="trucking" class="mx-auto grid max-w-6xl scroll-mt-20 items-center gap-8 px-4 py-12 md:grid-cols-2 md:gap-12 md:py-16">
    <div>
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Trucking & Logistics</h2>
      <p class="mt-2 text-slate-600">
        Dukungan pengiriman barang dengan koordinasi armada dan jadwal yang disesuaikan dengan kebutuhan operasional.
      </p>
      <ul class="mt-6 space-y-4">
        {trucking.map((t) => (
          <li class="border-l-2 border-brand pl-4">
            <h3 class="font-semibold text-slate-900">{t.judul}</h3>
            <p class="mt-0.5 text-slate-600">{t.isi}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-slate-500">Lingkup operasional dikonfirmasi sesuai kebutuhan dan ketersediaan.</p>
    </div>
    <Image
      src={truckingFoto}
      alt="Aktivitas pengiriman PT. Barokah Satria Expresindo"
      widths={[400, 800]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[4/3] w-full rounded-lg object-cover"
    />
  </section>

  <!-- 3. ARMADA -->
  <section id="armada" class="scroll-mt-20 border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Armada untuk Berbagai Kebutuhan Operasional</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {armada.map((a) => (
          <figure class="overflow-hidden rounded-lg border border-slate-200 bg-white">
            <Image
              src={a.foto}
              alt={a.alt}
              widths={[400, 800]}
              sizes="(min-width: 768px) 33vw, 100vw"
              class="aspect-[4/3] w-full object-cover"
            />
            <figcaption class="p-4 font-semibold text-slate-900">{a.nama}</figcaption>
          </figure>
        ))}
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {armadaPrinsip.map((p) => (
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wide text-brand">{p.judul}</h3>
            <p class="mt-1 text-slate-600">{p.isi}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. HUMAN CAPITAL -->
  <section id="sdm" class="mx-auto grid max-w-6xl scroll-mt-20 items-center gap-8 px-4 py-12 md:grid-cols-2 md:gap-12 md:py-16">
    <Image
      src={sdmFoto}
      alt="Tenaga kerja PT. Barokah Satria Expresindo"
      widths={[400, 800]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[4/3] w-full rounded-lg object-cover md:order-first"
    />
    <div>
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Human Capital Solution</h2>
      <p class="mt-2 text-slate-600">
        Dukungan kebutuhan tenaga kerja untuk membantu kelancaran operasional perusahaan. Penempatan tenaga kerja dan ruang lingkup tugas dibahas sesuai kebutuhan, kualifikasi, serta ketentuan yang disepakati bersama.
      </p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {sdm.map((s) => (
          <li class="rounded-lg border border-slate-200 px-4 py-3 font-medium text-slate-800">{s}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. SEKTOR -->
  <section id="sektor" class="scroll-mt-20 border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Sektor Industri & Peluang Kemitraan</h2>
      <p class="mt-2 max-w-3xl text-slate-600">
        Contoh sektor potensial yang dapat dijajaki sesuai kebutuhan mitra dan cakupan operasional.
      </p>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sektor.map((s) => (
          <div class="border-t-2 border-brand pt-4">
            <h3 class="font-semibold text-slate-900">{s.judul}</h3>
            <p class="mt-1 text-slate-600">{s.isi}</p>
          </div>
        ))}
      </div>
      <p class="mt-10 font-semibold text-brand-dark">
        Kami terbuka untuk mendiskusikan kebutuhan transportasi, logistik, dan dukungan SDM.
      </p>
      <a href="/kontak" class="mt-3 inline-block font-semibold text-brand hover:underline">Hubungi kami →</a>
    </div>
  </section>
</Layout>