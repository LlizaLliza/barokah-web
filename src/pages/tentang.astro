---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profilFoto from '../assets/armada-kontainer-20.jpg';   

const nilai = [
  { judul: 'Profesionalisme', isi: 'Bekerja dengan tanggung jawab dan komunikasi yang jelas.' },
  { judul: 'Keselamatan Kerja', isi: 'Mengutamakan prosedur keselamatan dalam aktivitas operasional.' },
  { judul: 'Ketepatan Waktu', isi: 'Menyusun jadwal dan memantau pelaksanaan bersama mitra.' },
  { judul: 'Fleksibilitas', isi: 'Lingkup layanan dibahas menyesuaikan kebutuhan setiap proyek.' },
  { judul: 'Koordinasi', isi: 'Menjaga komunikasi antar pihak terkait selama proses layanan.' },
  { judul: 'Evaluasi', isi: 'Membuka ruang umpan balik untuk perbaikan berkelanjutan.' },
];

const proses = [
  { judul: 'Konsultasi', isi: 'Memahami kebutuhan dan ruang lingkup layanan.' },
  { judul: 'Perencanaan', isi: 'Menyepakati jadwal, peran, dan kebutuhan pendukung.' },
  { judul: 'Pelaksanaan', isi: 'Koordinasi armada atau tenaga kerja sesuai kesepakatan.' },
  { judul: 'Evaluasi', isi: 'Meninjau pelaksanaan dan tindak lanjut perbaikan.' },
];

const k3 = [
  { judul: 'Keselamatan', isi: 'Mengutamakan prosedur dan perlengkapan kerja yang sesuai.' },
  { judul: 'Komunikasi', isi: 'Menginformasikan perubahan atau kendala dengan jelas.' },
  { judul: 'Disiplin', isi: 'Menjaga kesepakatan jadwal dan pembagian tanggung jawab.' },
  { judul: 'Perbaikan', isi: 'Mencatat umpan balik dan tindak lanjut yang diperlukan.' },
];
---
<Layout
  title="Tentang Kami | PT. Barokah Satria Expresindo"
  description="Profil PT. Barokah Satria Expresindo: mitra transportasi, logistik, dan dukungan SDM yang mengutamakan koordinasi, keselamatan, dan komunikasi yang jelas."
>
  <!-- 1. PROFIL -->
  <section class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-12 md:grid-cols-2 md:gap-12 md:py-16">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Tentang Kami</p>
      <h1 class="mt-2 text-3xl font-bold leading-tight text-slate-900 md:text-4xl">
        Partner in Transportation & Business Support
      </h1>
      <p class="mt-4 text-lg text-slate-600">
        Dukungan transportasi, logistik, dan sumber daya manusia yang dirancang untuk membantu kebutuhan operasional bisnis.
      </p>
      <p class="mt-4 text-slate-700">
        PT. Barokah Satria Expresindo hadir sebagai mitra layanan yang menghubungkan kebutuhan transportasi dan dukungan tenaga kerja. Dengan pendekatan yang mengutamakan koordinasi, keselamatan, serta komunikasi yang jelas, layanan dirancang agar selaras dengan kebutuhan setiap mitra.
      </p>
    </div>
    <Image
      src={profilFoto}
      alt="Armada dan aktivitas operasional PT. Barokah Satria Expresindo"
      widths={[400, 800]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[4/3] w-full rounded-lg object-cover"
    />
  </section>

  <!-- PROFIL LEGAL -->
  <section class="border-y border-slate-200 bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Informasi Perusahaan</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-lg border border-slate-200 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Nama Pelaku Usaha</h3>
          <p class="mt-1 font-semibold text-slate-900">PT BAROKAH SATRIA EXPRESINDO</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Nomor Induk Berusaha (NIB)</h3>
          <p class="mt-1 font-semibold text-slate-900">1310260073033</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Skala Usaha</h3>
          <p class="mt-1 font-semibold text-slate-900">Usaha Mikro</p>
        </div>
        <div class="rounded-lg border border-slate-200 p-5">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Alamat Terdaftar</h3>
          <p class="mt-1 text-slate-800">Viktoria residence no LX 4 , Kel. Meteseh, Kec. Tembalang, Kota Semarang</p>
        </div>
        <div class="col-span-full rounded-lg border border-slate-200 p-5 sm:col-span-2">
          <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500">Bidang Usaha (KBLI)</h3>
          <ul class="mt-2 space-y-2 text-slate-800">
            <li><strong>49231</strong> — Angkutan Bermotor untuk Barang Umum <span class="text-sm text-slate-500">(Risiko: Menengah Tinggi)</span></li>
            <li><strong>78200</strong> — Aktivitas Penyediaan Tenaga Kerja Sementara dan Penyediaan Sumber Daya Manusia Lainnya <span class="text-sm text-slate-500">(Risiko: Rendah)</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. VISI & MISI -->
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-12 md:grid-cols-2 md:py-16">
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-brand">Visi</h2>
        <!-- DRAFT:-->
        <p class="mt-3 text-lg text-slate-800">
          Menjadi mitra yang dipercaya dalam layanan transportasi, logistik, dan dukungan SDM.
        </p>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-6">
        <h2 class="text-sm font-bold uppercase tracking-wide text-brand">Misi</h2>
        <!-- DRAFT -->
        <p class="mt-3 text-lg text-slate-800">
          Memberikan layanan yang terkoordinasi, mengutamakan keselamatan, dan membangun kerja sama jangka panjang.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. NILAI LAYANAN -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Nilai Layanan</h2>
    <p class="mt-2 max-w-3xl text-slate-600">
      Nilai utama yang menjadi dasar koordinasi layanan dan hubungan kerja dengan mitra.
    </p>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {nilai.map((n) => (
        <div class="rounded-lg border border-slate-200 p-5">
          <h3 class="font-semibold text-slate-900">{n.judul}</h3>
          <p class="mt-1 text-slate-600">{n.isi}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 4. ALUR KERJA -->
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Proses Kerja yang Terarah</h2>
      <p class="mt-2 max-w-3xl text-slate-600">
        Tahapan kerja dapat disepakati bersama agar kebutuhan, tanggung jawab, dan koordinasi pelaksanaan lebih jelas.
      </p>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 md:grid-cols-4">
        {proses.map((p, i) => (
          <li class="border-t-2 border-brand pt-4">
            <span class="text-sm font-bold text-brand">0{i + 1}</span>
            <h3 class="mt-1 text-lg font-semibold text-slate-900">{p.judul}</h3>
            <p class="mt-2 text-slate-600">{p.isi}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. K3 -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Komitmen Operasional & K3</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {k3.map((k) => (
        <div class="border-l-2 border-brand pl-4">
          <h3 class="font-semibold text-slate-900">{k.judul}</h3>
          <p class="mt-1 text-slate-600">{k.isi}</p>
        </div>
      ))}
    </div>
    <a href="/layanan" class="mt-10 inline-block font-semibold text-brand hover:underline">Lihat layanan kami →</a>
  </section>
</Layout>