---
import Layout from '../layouts/Layout.astro';
import { site, waLink } from '../site';

const field =
  'mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 text-slate-900 placeholder:text-slate-400 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30';
const label = 'block text-sm font-medium text-slate-800';

const mapQuery = encodeURIComponent('Viktoria residence no LX 4 , Kel. Meteseh, Kec. Tembalang, Kota Semarang');
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---
<Layout
  title="Kontak | PT. Barokah Satria Expresindo"
  description="Hubungi PT. Barokah Satria Expresindo di Tembalang, Semarang untuk kebutuhan trucking, logistik, dan dukungan SDM."
>
  <!-- 1. KONTAK + FORM -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand">Hubungi Kami</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-900 md:text-4xl">Mari Bicarakan Kebutuhan Anda</h1>
    <p class="mt-4 max-w-3xl text-slate-600">
      Hubungi tim {site.name} untuk mendiskusikan kebutuhan trucking, logistik, dan dukungan SDM.
    </p>

    <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-12">
      <!-- Kolom kiri: detail kontak -->
      <div>
        <dl class="space-y-6">
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Alamat</dt>
            <dd class="mt-1 text-slate-800">{site.address}</dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Telepon</dt>
            <dd class="mt-1 space-y-1">
              <div>
                <a href={`tel:${site.phoneHref}`} class="text-lg font-semibold text-brand hover:underline">{site.phone}</a>
              </div>
              <div>
                <a href={`tel:${site.phone2Href}`} class="text-lg font-semibold text-brand hover:underline">{site.phone2}</a>
              </div>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold uppercase tracking-wide text-slate-500">Email</dt>
            <dd class="mt-1">
              <a href={`mailto:${site.email}`} class="break-all font-semibold text-brand hover:underline">{site.email}</a>
            </dd>
          </div>
        </dl>
        <a
          href={waLink}
          class="mt-8 inline-block w-full rounded-md bg-brand px-5 py-3 text-center font-semibold text-white hover:bg-brand-dark sm:w-auto"
        >
          Chat WhatsApp
        </a>
      </div>

      <!-- Kolom kanan: form direct-to-WhatsApp -->
      <form
        id="kontak-form"
        class="space-y-4"
      >
        <div>
          <label for="nama" class={label}>Nama</label>
          <input id="nama" name="nama" type="text" required autocomplete="name" class={field} />
        </div>

        <div>
          <label for="perusahaan" class={label}>Perusahaan <span class="font-normal text-slate-500">(opsional)</span></label>
          <input id="perusahaan" name="perusahaan" type="text" autocomplete="organization" class={field} />
        </div>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="telepon" class={label}>Telepon / WhatsApp</label>
            <input id="telepon" name="telepon" type="tel" inputmode="tel" required autocomplete="tel" class={field} />
          </div>
          <div>
            <label for="email-field" class={label}>Email <span class="font-normal text-slate-500">(opsional)</span></label>
            <input id="email-field" name="email" type="email" autocomplete="email" class={field} />
          </div>
        </div>

        <div>
          <label for="kebutuhan" class={label}>Kebutuhan</label>
          <select id="kebutuhan" name="kebutuhan" required class={field}>
            <option value="" disabled selected>Pilih kebutuhan</option>
            <option>Trucking &amp; Logistics</option>
            <option>Human Capital Solution</option>
            <option>Lainnya</option>
          </select>
        </div>

        <div>
          <label for="pesan" class={label}>Pesan</label>
          <textarea id="pesan" name="pesan" rows="5" required class={field}></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-brand px-5 py-3 font-semibold text-white hover:bg-brand-dark sm:w-auto"
        >
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Kirim via WhatsApp
        </button>

        <p class="text-xs text-slate-500">
          Form ini akan membuka WhatsApp dengan pesan yang sudah terformat. Pastikan WhatsApp sudah terpasang di perangkat Anda.
        </p>
      </form>

      <script define:vars={{ waNumber: site.whatsapp }}>
        document.getElementById('kontak-form').addEventListener('submit', function (e) {
          e.preventDefault();

          const nama = document.getElementById('nama').value.trim();
          const perusahaan = document.getElementById('perusahaan').value.trim();
          const telepon = document.getElementById('telepon').value.trim();
          const email = document.getElementById('email-field').value.trim();
          const kebutuhan = document.getElementById('kebutuhan').value;
          const pesan = document.getElementById('pesan').value.trim();

          let message = `Halo, saya ingin menghubungi PT. Barokah Satria Expresindo.\n\n`;
          message += `*Nama:* ${nama}\n`;
          if (perusahaan) message += `*Perusahaan:* ${perusahaan}\n`;
          message += `*Telepon:* ${telepon}\n`;
          if (email) message += `*Email:* ${email}\n`;
          message += `*Kebutuhan:* ${kebutuhan}\n`;
          message += `\n*Pesan:*\n${pesan}`;

          const url = `https://wa.me/${waNumber}?text=${encodeURIComponent(message)}`;
          window.open(url, '_blank');
        });
      </script>

    </div>
  </section>

  <!-- 2. PETA -->
  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Lokasi Kami</h2>
      <p class="mt-2 text-slate-600">{site.address}</p>
      <iframe
        src={mapEmbed}
        title={`Peta lokasi ${site.name}`}
        class="mt-6 h-72 w-full rounded-lg border border-slate-200 sm:h-96"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
      <a href={mapLink} class="mt-4 inline-block font-semibold text-brand hover:underline">Buka di Google Maps →</a>
    </div>
  </section>
</Layout>