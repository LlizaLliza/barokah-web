---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { site, waLink } from '../site';
import hero from '../assets/hero.jpg';
import truckingFoto from '../assets/armada-cddl.jpg';
import sdmFoto from '../assets/sdm.jpg';

const layanan = [
  {
    href: '/layanan#trucking',
    judul: 'Trucking & Logistics',
    isi: 'Dukungan pengiriman barang dengan koordinasi armada dan jadwal yang disesuaikan dengan kebutuhan operasional.',
    foto: truckingFoto,
    alt: 'Armada truk PT. Barokah Satria Expresindo',
  },
  {
    href: '/layanan#sdm',
    judul: 'Human Capital Solution',
    isi: 'Dukungan kebutuhan tenaga kerja untuk membantu kelancaran operasional perusahaan.',
    foto: sdmFoto,
    alt: 'Tenaga kerja PT. Barokah Satria Expresindo',
  },
];

const keunggulan = [
  { judul: 'Profesionalisme', isi: 'Bekerja dengan tanggung jawab dan komunikasi yang jelas.' },
  { judul: 'Keselamatan Kerja', isi: 'Mengutamakan prosedur keselamatan dalam aktivitas operasional.' },
  { judul: 'Ketepatan Waktu', isi: 'Menyusun jadwal dan memantau pelaksanaan bersama mitra.' },
];
---
<Layout
  title="PT. Barokah Satria Expresindo | Trucking, Logistik & Human Capital Semarang"
  description="Mitra transportasi, logistik, dan dukungan SDM di Semarang. Koordinasi armada, penjadwalan pengiriman, dan penempatan tenaga kerja sesuai kebutuhan operasional Anda."
>
  <!-- 1. HERO -->
  <section class="bg-slate-50">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-12 md:grid-cols-2 md:gap-12 md:py-20">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-brand">
          Trucking & Logistics · Human Capital Solution
        </p>
        <h1 class="mt-3 text-3xl font-bold leading-tight text-slate-900 sm:text-4xl md:text-5xl">
          Your Trusted Partner for Transportation & Human Resources
        </h1>
        <p class="mt-4 text-lg text-slate-600">{site.tagline}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/kontak" class="rounded-md bg-brand px-5 py-3 text-center font-semibold text-white hover:bg-brand-dark">
            Hubungi Kami
          </a>
          <a href="/layanan" class="rounded-md border border-slate-300 bg-white px-5 py-3 text-center font-semibold text-slate-800 hover:border-brand hover:text-brand">
            Lihat Layanan
          </a>
        </div>
      </div>

      <Image
        src={hero}
        alt="Armada truk PT. Barokah Satria Expresindo"
        widths={[640, 1280]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] w-full rounded-lg object-cover"
      />
    </div>
  </section>

  <!-- 2. RINGKASAN LAYANAN -->
  <section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Layanan Utama</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {layanan.map((l) => (
        <a
          href={l.href}
          class="group block overflow-hidden rounded-lg border border-slate-200 bg-white transition hover:border-brand hover:shadow-md"
        >
          <Image
            src={l.foto}
            alt={l.alt}
            widths={[400, 800]}
            sizes="(min-width: 768px) 50vw, 100vw"
            class="aspect-[16/9] w-full object-cover"
          />
          <div class="p-6">
            <h3 class="text-xl font-semibold text-slate-900">{l.judul}</h3>
            <p class="mt-2 text-slate-600">{l.isi}</p>
            <span class="mt-4 inline-block font-semibold text-brand group-hover:underline">Lihat detail →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. PRINSIP KERJA -->
  <section class="border-t border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h2 class="text-2xl font-bold text-slate-900 md:text-3xl">Prinsip Kerja Kami</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {keunggulan.map((k, i) => (
          <div class="border-t-2 border-brand pt-4">
            <span class="text-sm font-bold text-brand">0{i + 1}</span>
            <h3 class="mt-1 text-lg font-semibold text-slate-900">{k.judul}</h3>
            <p class="mt-2 text-slate-600">{k.isi}</p>
          </div>
        ))}
      </div>
      <a href="/tentang" class="mt-8 inline-block font-semibold text-brand hover:underline">Lihat semua nilai kami →</a>
    </div>
  </section>

  <!-- 4. CTA -->
  <section class="bg-brand-dark text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h2 class="text-2xl font-bold md:text-3xl">Mari Bicarakan Kebutuhan Anda</h2>
      <p class="mt-3 max-w-2xl text-white/80">
        Hubungi tim {site.name} untuk mendiskusikan kebutuhan trucking, logistik, dan dukungan SDM.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={waLink} class="rounded-md bg-white px-5 py-3 text-center font-semibold text-brand-dark hover:bg-slate-100">
          Chat WhatsApp
        </a>
        <a href="/kontak" class="rounded-md border border-white/60 px-5 py-3 text-center font-semibold text-white hover:bg-white/10">
          Lihat Kontak
        </a>
      </div>
    </div>
  </section>
</Layout>