---
import Layout from '../layouts/Layout.astro';
import { site } from '../site';

const layanan = [
  {
    href: '/layanan#trucking',
    judul: 'Trucking & Logistics',
    isi: 'Dukungan pengiriman barang dengan koordinasi armada dan jadwal yang disesuaikan dengan kebutuhan operasional.',
  },
  {
    href: '/layanan#sdm',
    judul: 'Human Capital Solution',
    isi: 'Dukungan kebutuhan tenaga kerja untuk membantu kelancaran operasional perusahaan.',
  },
];

const keunggulan = [
  { judul: 'Profesionalisme', isi: 'Bekerja dengan tanggung jawab dan komunikasi yang jelas.' },
  { judul: 'Keselamatan Kerja', isi: 'Mengutamakan prosedur keselamatan dalam aktivitas operasional.' },
  { judul: 'Ketepatan Waktu', isi: 'Menyusun jadwal dan memantau pelaksanaan bersama mitra.' },
];
---
<Layout
  title="PT. Barokah Satria Expresindo | Trucking, Logistik & Human Capital Semarang"
  description="Mitra transportasi, logistik, dan dukungan SDM di Semarang. Koordinasi armada, penjadwalan pengiriman, dan penempatan tenaga kerja sesuai kebutuhan operasional Anda."
>
  <section class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Trucking & Logistics · Human Capital Solution</p>
      <h1 class="mt-3 max-w-3xl text-3xl font-bold text-slate-900 md:text-5xl">
        Your Trusted Partner for Transportation & Human Resources
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">{site.tagline}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/kontak" class="rounded-md bg-brand px-5 py-3 font-semibold text-white hover:bg-brand-dark">Hubungi Kami</a>
        <a href="/layanan" class="rounded-md border border-slate-300 px-5 py-3 font-semibold text-slate-800 hover:bg-white">Lihat Layanan</a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-2xl font-bold text-slate-900">Layanan Utama</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {layanan.map((l) => (
        <a href={l.href} class="block rounded-lg border border-slate-200 p-6 hover:border-brand">
          <h3 class="text-xl font-semibold text-slate-900">{l.judul}</h3>
          <p class="mt-2 text-slate-600">{l.isi}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <h2 class="text-2xl font-bold text-slate-900">Prinsip Kerja Kami</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {keunggulan.map((k) => (
        <div>
          <h3 class="font-semibold text-slate-900">{k.judul}</h3>
          <p class="mt-1 text-slate-600">{k.isi}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-brand-dark text-white">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <h2 class="text-2xl font-bold">Mari Bicarakan Kebutuhan Anda</h2>
      <p class="mt-2 max-w-2xl text-white/80">
        Hubungi tim {site.name} untuk mendiskusikan kebutuhan trucking, logistik, dan dukungan SDM.
      </p>
      <a href="/kontak" class="mt-6 inline-block rounded-md bg-white px-5 py-3 font-semibold text-brand-dark">Hubungi Kami</a>
    </div>
  </section>
</Layout>